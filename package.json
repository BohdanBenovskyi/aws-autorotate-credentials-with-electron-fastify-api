{
  "name": "aws-autorotate-credentials-with-electron-fastify-api",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "tsc --build tsconfig.json && tsc-alias",
    "build:watch": "concurrently --kill-others \"tsc -w\" \"tsc-alias -w\"",
    "start": "node --inspect=0.0.0.0:9229 ./build/src/server.js",
    "build:start": "npm run build && npm run start",
    "build:start:pm2": "npx prisma generate && npm run build && pm2-runtime ecosystem.config.js",
    "test": "jest",
    "lint": "eslint .",
    "prettier:check": "prettier --check \"**/*.{ts,tsx,js,mjs,md,mdx,css,yaml,yml}\"",
    "prettier:format": "prettier --write \"**/*.{ts,tsx,js,mjs,md,mdx,css,yaml,yml}\"",
    "seed": "ts-node ./src/db/seed.ts",
    "jest:debug": "node --nolazy --inspect-brk ./node_modules/jest/bin/jest.js --runInBand --colors --verbose"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/cookie": "^11.0.1",
    "@fastify/jwt": "^9.0.1",
    "@prisma/client": "^5.22.0",
    "bcrypt": "^5.1.1",
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0",
    "fastify-type-provider-zod": "^4.0.2",
    "pm2": "^5.4.2"
  },
  "devDependencies": {
    "@eslint/compat": "^1.2.0",
    "@eslint/eslintrc": "^3.1.0",
    "@eslint/js": "^9.12.0",
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.2.0",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "concurrently": "^8.2.2",
    "eslint": "^9.12.0",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-import": "^2.31.0",
    "globals": "^15.10.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "prisma": "^5.22.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.10",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.8.0"
  }
}
